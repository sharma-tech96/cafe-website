find second lagest number 


#include <stdio.h>
int main()
{
    int a[20], i, max, second;
    printf("Enter 20 elements:\n");
    for(i = 0; i < 20; i++)
    {
        scanf("%d", &a[i]);
    }
    max = a[0];
    second = a[0];
    for(i = 1; i < 20; i++)
    {
        if(a[i] > max)
        {
            second = max;
            max = a[i];
        }
        else if(a[i] > second && a[i] < max)
        {
            second = a[i];
        }
    }
    printf("\nSecond largest element = %d", second);

    return 0;
}

second method to find second lagest number



#include <stdio.h>

int main()
{
    int a[20], i, max, second;
    printf("Enter 20 elements:\n");
    for(i = 0; i < 20; i++)
    {
        scanf("%d", &a[i]);
    }
    max = a[0];
    second = a[1];
    if(second < max)
    {    
        max = a[0];
        second = a[1];
    }
    for(i = 2; i < 20; i++)
    {
        if(a[i] > max)
        {
            second = max;
            max = a[i];
        }
        else if(a[i] > second && a[i] < max)
        {
            second = a[i];
        }
    }
    printf("\nLargest element = %d", max);
    printf("\nSecond largest element = %d", second);

    return 0;
}


find max  and min in  single array



#include <stdio.h>

int main()
{
    int a[20], i, max, min;

    printf("Enter 20 elements:\n");
    for(i = 0; i < 20; i++)
    {
        scanf("%d", &a[i]);
    }

    max = a[0];
    min = a[0];

    for(i = 1; i < 20; i++)
    {
        if(a[i] > max)
        {
            max = a[i];
        }

        if(a[i] < min)
        {
            min = a[i];
        }
    }
    printf("\nMaximum element = %d", max);
    printf("\nMinimum element = %d", min);

    return 0;
}

