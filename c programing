reverse array display


#include <stdio.h>
int main()
{
    int a[20], i;
    printf("Enter 20 elements:\n");
    for(i = 0; i < 20; i++)
    {
        scanf("%d", &a[i]);
    }
    printf("\nArray elements in reverse order:\n");
    for(i = 19; i >= 0; i--)
    {
        printf("%d ", a[i]);
    }
    return 0;
}


find max element in array


#include <stdio.h>
int main()
{
    int a[20], i, max, pos;
    printf("Enter 20 elements:\n");
    for(i = 0; i < 20; i++)
    {
        scanf("%d", &a[i]);
    }
    max = a[0];
    pos = 0;
    for(i = 1; i < 20; i++)
    {
        if(a[i] > max)
        {
            max = a[i];
            pos = i;
        }
    }
    printf("\nMaximum element = %d", max);
    printf("\nPosition = %d", pos + 1);

    return 0;
}
































































