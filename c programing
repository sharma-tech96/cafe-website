3. parameter solve pattern

#include <stdio.h>

int main() {
    int i, j;

    for (i = 1; i <= 5; i++) {
        for (j = 1; j <= 5; j++) {
            printf("* ");
        }
        printf("\n");
    }

    return 0;
}


4. print pattern

#include <stdio.h>

int main() {
    int i, j, n = 1;

    for (i = 1; i <= 5; i++) {
        for (j = 1; j <= 5; j++) {
            printf("%d", i);
        }
        printf("\n");
    }

    return 0;
}


